    def update_airpods_logo(self):
        pix = QPixmap("/opt/podhop/airpods.png")
        if not pix.isNull():
            dpr = get_dpr()
            phys = int(40 * dpr)
            scaled = pix.scaled(phys, phys, Qt.KeepAspectRatio, Qt.SmoothTransformation)
            scaled.setDevicePixelRatio(dpr)
            self.img_airpods.setPixmap(scaled)

