#!/usr/bin/env python3
"""PodHop GUI — Trình điều khiển AirPods 4 ANC cao cấp cho Linux.

Thiết kế chuẩn Apple Design Guidelines (macOS Control Center / iOS 18):
- Kích thước siêu gọn nhẹ (400x615px), vừa vặn mọi màn hình laptop.
- Trình phát đa phương tiện (Now Playing Media Player) tương thích mọi ứng dụng Linux qua MPRIS.
- Segmented Control 4 chế độ chống ồn chuẩn Apple Sound Control.
- Nhóm cài đặt thông minh phong cách iOS Settings Grouped Table.
- Chế độ Sáng / Tối tự động theo hệ thống hoặc chuyển đổi thủ công.
- Hỗ trợ màn hình HiDPI / Retina (DPR 2.0x) sắc nét từng pixel.
- Chạy ngầm êm ái, cơ chế Single-Instance không trùng lặp tiến trình.
"""

import codecs
import ctypes
import gc
import json
import os
import re
import socket
import subprocess
import sys
import threading
import time

try:
    libc = ctypes.CDLL('libc.so.6')
    if hasattr(libc, 'mallopt'):
        libc.mallopt(-1, 65536)  # M_TRIM_THRESHOLD = 64KB
except Exception:
    libc = None


from PySide6.QtCore import Qt, QTimer, Signal, QObject, Property, QPropertyAnimation, QEasingCurve, QByteArray, QSize, QRectF
from PySide6.QtGui import QFont, QIcon, QPixmap, QGuiApplication, QPainter, QColor, QPainterPath, QFontMetrics, QKeySequence, QShortcut
from PySide6.QtSvg import QSvgRenderer
from PySide6.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout, QGridLayout,
    QLabel, QPushButton, QFrame, QAbstractButton, QSizePolicy
)

CONFIG_PATH = os.path.expanduser("~/.config/podhop.json")
UNIX_SOCK_PATH = f"/run/user/{os.getuid()}/podhop.sock"
GUI_SOCK_PATH = f"/run/user/{os.getuid()}/podhop_gui.sock"
ICONS_DIR = "/opt/podhop/icons"

def get_dpr():
    screen = QGuiApplication.primaryScreen()
    return screen.devicePixelRatio() if screen else 2.0

_PIXMAP_CACHE = {}

def load_tinted_pixmap(icon_name, color_hex, size=(16, 16)):
    dpr = get_dpr()
    cache_key = (icon_name, color_hex, size, dpr)
    if cache_key in _PIXMAP_CACHE:
        return _PIXMAP_CACHE[cache_key]

    svg_path = os.path.join(ICONS_DIR, f"{icon_name}.svg")
    if not os.path.exists(svg_path):
        return QPixmap()
    try:
        with open(svg_path, "r") as f:
            content = f.read()
        content = content.replace('stroke="#0F172A"', f'stroke="{color_hex}"')
        content = content.replace('stroke="currentColor"', f'stroke="{color_hex}"')
        content = content.replace('fill="currentColor"', f'fill="{color_hex}"')
        content = content.replace('stroke-width="1.5"', 'stroke-width="1.8"')

        dpr = get_dpr()
        renderer = QSvgRenderer(QByteArray(content.encode()))
        phys_w = int(size[0] * dpr)
        phys_h = int(size[1] * dpr)
        pixmap = QPixmap(phys_w, phys_h)
        pixmap.setDevicePixelRatio(dpr)
        pixmap.fill(Qt.transparent)
        painter = QPainter(pixmap)
        painter.setRenderHint(QPainter.Antialiasing)
        painter.setRenderHint(QPainter.SmoothPixmapTransform)
        renderer.render(painter, QRectF(0, 0, size[0], size[1]))
        painter.end()
        _PIXMAP_CACHE[cache_key] = pixmap
        return pixmap
    except Exception:
        return QPixmap()

def load_tinted_icon(icon_name, color_hex, size=(16, 16)):
    pm = load_tinted_pixmap(icon_name, color_hex, size)
    icon = QIcon()
    icon.addPixmap(pm)
    return icon

def send_daemon_cmd(cmd):
    if not os.path.exists(UNIX_SOCK_PATH):
        return None
    try:
        to = 15.0 if cmd.startswith("switch") else 2.5
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(to)
            s.connect(UNIX_SOCK_PATH)
            s.sendall((cmd + "\n").encode())
            resp = s.recv(1024).decode().strip()
            return resp
    except Exception:
        return None

def try_raise_existing_instance():
    """Kiểm tra xem app đã chạy ngầm chưa. Nếu có, gửi tín hiệu hiện cửa sổ."""
    if not os.path.exists(GUI_SOCK_PATH):
        return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.8)
            s.connect(GUI_SOCK_PATH)
            s.sendall(b"SHOW\n")
            resp = s.recv(64).decode().strip()
            return resp == "OK"
    except Exception:
        try:
            os.unlink(GUI_SOCK_PATH)
        except OSError:
            pass
        return False

def get_system_theme():
    try:
        scheme = QGuiApplication.styleHints().colorScheme()
        if scheme == Qt.ColorScheme.Dark:
            return "dark"
        elif scheme == Qt.ColorScheme.Light:
            return "light"
    except Exception:
        pass

    try:
        res = subprocess.run(
            ["busctl", "--user", "call", "org.freedesktop.portal.Desktop",
             "/org/freedesktop/portal/desktop", "org.freedesktop.portal.Settings",
             "Read", "ss", "org.freedesktop.appearance", "color-scheme"],
            capture_output=True, text=True, timeout=1
        )
        if "u 1" in res.stdout:
            return "dark"
        elif "u 2" in res.stdout:
            return "light"
    except Exception:
        pass
    return "dark"

class MediaController:
    """Điều khiển phát nhạc toàn hệ thống qua chuẩn D-Bus MPRIS & playerctl."""
    def __init__(self):
        self.cached_player = None

    def get_media_info(self):
        try:
            res = subprocess.run(
                ["playerctl", "metadata", "--format", "{{status}}:::{{playerName}}:::{{title}}:::{{artist}}:::{{mpris:artUrl}}"],
                capture_output=True, text=True, timeout=0.4
            )
            out = res.stdout.strip()
            if out and ":::" in out:
                parts = out.split(":::", 4)
                status = parts[0].strip() or "Stopped"
                player = parts[1].strip() or "Media"
                title = parts[2].strip() or "Không có tiêu đề"
                artist = parts[3].strip() or player.capitalize()
                art_url = parts[4].strip().replace("file://", "") if len(parts) > 4 else ""
                return f"org.mpris.MediaPlayer2.{player}", status, {
                    "title": title,
                    "artist": artist,
                    "art_url": art_url,
                    "app_name": player.capitalize()
                }
        except Exception:
            pass
        player, status = self.get_active_player()
        meta = self.get_metadata(player)
        return player, status, meta

    def get_active_player(self):
        # 1. Try playerctl
        try:
            res = subprocess.run(["playerctl", "-l"], capture_output=True, text=True, timeout=0.6)
            plist = [p.strip() for p in res.stdout.splitlines() if p.strip()]
            for p in plist:
                st_res = subprocess.run(["playerctl", "-p", p, "status"], capture_output=True, text=True, timeout=0.4)
                st = st_res.stdout.strip()
                if st == "Playing":
                    return f"org.mpris.MediaPlayer2.{p}", "Playing"
            for p in plist:
                st_res = subprocess.run(["playerctl", "-p", p, "status"], capture_output=True, text=True, timeout=0.4)
                st = st_res.stdout.strip()
                if st == "Paused":
                    return f"org.mpris.MediaPlayer2.{p}", "Paused"
        except Exception:
            pass

        # 2. Fallback to busctl
        try:
            res = subprocess.run(["busctl", "--user", "list"], capture_output=True, text=True, timeout=0.6)
            players = [line.split()[0] for line in res.stdout.splitlines() if line.split() and line.split()[0].startswith("org.mpris.MediaPlayer2.")]
            if not players:
                return None, "Stopped"
            
            for p in players:
                st = self.get_player_status(p)
                if st == "Playing":
                    self.cached_player = p
                    return p, st
            
            for p in players:
                st = self.get_player_status(p)
                if st == "Paused":
                    self.cached_player = p
                    return p, st
            
            return players[0], "Stopped"
        except Exception:
            return None, "Stopped"

    def get_player_status(self, player):
        try:
            res = subprocess.run(
                ["busctl", "--user", "get-property", player, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "PlaybackStatus"],
                capture_output=True, text=True, timeout=0.5
            )
            out = res.stdout.strip().replace('"', '').replace('s ', '')
            return out or "Stopped"
        except Exception:
            return "Stopped"

    def get_metadata(self, player):
        if not player:
            return {
                "title": "Không có bài hát đang phát",
                "artist": "Mở trình duyệt hoặc ứng dụng nhạc",
                "art_url": "",
                "app_name": "Media"
            }
        try:
            res = subprocess.run(
                ["busctl", "--user", "get-property", player, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "Metadata"],
                capture_output=True, text=True, timeout=0.8
            )
            meta_str = res.stdout

            def decode_val(s):
                try:
                    return codecs.escape_decode(s.encode("latin1"))[0].decode("utf-8")
                except Exception:
                    return s

            title = ""
            m_title = re.search(r'"xesam:title"\s+s\s+"([^"]+)"', meta_str)
            if m_title:
                title = decode_val(m_title.group(1))

            artist = ""
            m_artist = re.search(r'"xesam:artist"\s+as\s+\d+\s+"([^"]+)"', meta_str)
            if m_artist:
                artist = decode_val(m_artist.group(1))

            art_url = ""
            m_art = re.search(r'"mpris:artUrl"\s+s\s+"([^"]+)"', meta_str)
            if m_art:
                art_url = m_art.group(1).replace("file://", "")

            app_name = player.removeprefix("org.mpris.MediaPlayer2.").split(".")[0].capitalize()
            return {
                "title": title or "Không có tiêu đề",
                "artist": artist or app_name,
                "art_url": art_url,
                "app_name": app_name
            }
        except Exception:
            return {
                "title": "Không có bài hát đang phát",
                "artist": "Chưa có trình phát nào",
                "art_url": "",
                "app_name": "Media"
            }

    def play_pause(self):
        player, st = self.get_active_player()
        # 1. Try playerctl
        try:
            if st == "Playing":
                res = subprocess.run(["playerctl", "pause"], capture_output=True, timeout=1)
                if res.returncode == 0:
                    return
            elif st in ("Paused", "Stopped"):
                res = subprocess.run(["playerctl", "play"], capture_output=True, timeout=1)
                if res.returncode == 0:
                    return
            res = subprocess.run(["playerctl", "play-pause"], capture_output=True, timeout=1)
            if res.returncode == 0:
                return
        except Exception:
            pass

        # 2. Fallback to busctl
        if player:
            target_method = "Pause" if st == "Playing" else "Play"
            try:
                subprocess.run(
                    ["busctl", "--user", "call", player, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", target_method],
                    capture_output=True, timeout=1
                )
            except Exception:
                try:
                    subprocess.run(
                        ["busctl", "--user", "call", player, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "PlayPause"],
                        capture_output=True, timeout=1
                    )
                except Exception:
                    pass

    def next_track(self):
        try:
            res = subprocess.run(["playerctl", "next"], capture_output=True, timeout=1)
            if res.returncode == 0:
                return
        except Exception:
            pass
        player, _ = self.get_active_player()
        if player:
            subprocess.run(
                ["busctl", "--user", "call", player, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "Next"],
                capture_output=True, timeout=1
            )

    def previous_track(self):
        try:
            res = subprocess.run(["playerctl", "previous"], capture_output=True, timeout=1)
            if res.returncode == 0:
                return
        except Exception:
            pass
        player, _ = self.get_active_player()
        if player:
            subprocess.run(
                ["busctl", "--user", "call", player, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "Previous"],
                capture_output=True, timeout=1
            )

class AppleToggle(QAbstractButton):
    """Công tắc iOS Toggle Switch siêu mượt mà."""
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setCheckable(True)
        self.setFixedSize(38, 22)
        self.setCursor(Qt.PointingHandCursor)
        self._pos = 2.0
        self.is_dark = True
        self.anim = QPropertyAnimation(self, b"thumb_pos", self)
        self.anim.setDuration(130)
        self.anim.setEasingCurve(QEasingCurve.OutCubic)

    def set_dark(self, is_dark):
        self.is_dark = is_dark
        self.update()

    def get_thumb_pos(self):
        return self._pos

    def set_thumb_pos(self, pos):
        self._pos = pos
        self.update()

    thumb_pos = Property(float, get_thumb_pos, set_thumb_pos)

    def nextCheckState(self):
        super().nextCheckState()
        self.anim.stop()
        self.anim.setStartValue(self._pos)
        self.anim.setEndValue(18.0 if self.isChecked() else 2.0)
        self.anim.start()

    def setChecked(self, checked):
        super().setChecked(checked)
        self._pos = 18.0 if checked else 2.0
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)

        if self.isChecked():
            # Action Blue #0071E3
            bg_color = QColor("#0071E3")
        else:
            bg_color = QColor(120, 120, 128, 70) if self.is_dark else QColor(120, 120, 128, 45)

        # Track
        p.setBrush(bg_color)
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(0, 0, 38, 22, 11, 11)

        # Thumb
        p.setBrush(QColor("#FFFFFF"))
        p.setPen(QColor(0, 0, 0, 25))
        p.drawEllipse(int(self._pos), 2, 18, 18)
        p.end()

class GUIIPCListener(QObject):
    raise_requested = Signal()

    def __init__(self, parent=None):
        super().__init__(parent)
        self.running = True
        self.sock = None
        threading.Thread(target=self._run, daemon=True).start()

    def _run(self):
        if os.path.exists(GUI_SOCK_PATH):
            try:
                os.unlink(GUI_SOCK_PATH)
            except OSError:
                pass
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            self.sock.bind(GUI_SOCK_PATH)
            self.sock.listen(5)
            self.sock.settimeout(0.5)
            while self.running:
                try:
                    conn, _ = self.sock.accept()
                    conn.settimeout(1.0)
                    msg = conn.recv(64).decode().strip()
                    if msg == "SHOW":
                        self.raise_requested.emit()
                        conn.sendall(b"OK\n")
                    conn.close()
                except socket.timeout:
                    continue
                except Exception:
                    pass
        finally:
            if self.sock:
                try:
                    self.sock.close()
                except Exception:
                    pass
            if os.path.exists(GUI_SOCK_PATH):
                try:
                    os.unlink(GUI_SOCK_PATH)
                except OSError:
                    pass

class AirPodsManager(QMainWindow):
    def __init__(self):
        super().__init__()
        self.addr = "70:AE:2A:59:B8:8C"
        self.name = "AirPod 4 ANC của KXT"
        self.theme_pref = "system"
        self.effective_theme = "dark"
        self.current_mode = "anc"
        self.adaptive_strength = 50
        self.media_ctrl = MediaController()
        self.is_playing = False

        # Single instance listener
        self.listener = GUIIPCListener(self)
        self.listener.raise_requested.connect(self.on_raise_requested)

        self.setup_ui()
        self.load_settings()
        self.apply_theme(self.theme_pref)

        # Shortcuts
        QShortcut(QKeySequence("Ctrl+Q"), self, self.quit_app)

        # Refresh loop
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh_state)
        self.timer.start(1500)
        self.refresh_state()

    def quit_app(self):
        QApplication.quit()

    def on_raise_requested(self):
        self.show()
        self.showNormal()
        self.raise_()
        self.activateWindow()

    def closeEvent(self, event):
        # Ẩn giao diện để app tiếp tục chạy ngầm mà không hiển thị tray icon
        event.ignore()
        self.hide()

    def hideEvent(self, event):
        super().hideEvent(event)
        if hasattr(self, 'timer') and self.timer.isActive():
            self.timer.stop()
        # Giải phóng bộ nhớ RAM triệt để khi ẩn cửa sổ
        gc.collect()
        if libc and hasattr(libc, 'malloc_trim'):
            libc.malloc_trim(0)

    def showEvent(self, event):
        super().showEvent(event)
        self.refresh_state()
        if hasattr(self, 'timer') and not self.timer.isActive():
            self.timer.start(1500)

    def load_settings(self):
        if os.path.exists(CONFIG_PATH):
            try:
                with open(CONFIG_PATH, "r") as f:
                    cfg = json.load(f)
                    self.theme_pref = cfg.get("theme", "system")
                    self.adaptive_strength = cfg.get("adaptive_strength", 50)
            except Exception:
                pass

    def save_settings(self):
        cfg = {}
        if os.path.exists(CONFIG_PATH):
            try:
                cfg = json.load(open(CONFIG_PATH))
            except Exception:
                pass
        cfg["theme"] = self.theme_pref
        cfg["adaptive_strength"] = self.adaptive_strength
        try:
            with open(CONFIG_PATH, "w") as f:
                json.dump(cfg, f, indent=2)
        except Exception:
            pass

    def setup_ui(self):
        self.setWindowTitle("AirPods 4 ANC")
        self.setFixedSize(400, 675)
        self.setWindowFlags(Qt.Window | Qt.WindowMinimizeButtonHint | Qt.WindowCloseButtonHint)
        self.setAttribute(Qt.WA_QuitOnClose, False)

        central = QWidget()
        self.setCentralWidget(central)
        layout = QVBoxLayout(central)
        layout.setContentsMargins(14, 12, 14, 12)
        layout.setSpacing(9)

        # ================= 1. Header (AirPods Icon + Title + Status + Theme Switcher) =================
        header_card = QFrame()
        header_card.setObjectName("headerCard")
        h_layout = QHBoxLayout(header_card)
        h_layout.setContentsMargins(12, 8, 12, 8)
        h_layout.setSpacing(10)

        self.img_airpods = QLabel()
        self.img_airpods.setFixedSize(40, 40)
        self.update_airpods_logo()
        h_layout.addWidget(self.img_airpods)

        info_col = QVBoxLayout()
        info_col.setSpacing(2)
        self.lbl_title = QLabel("AirPods 4 ANC")
        self.lbl_title.setFont(QFont("SF Pro Text", 13, QFont.DemiBold))
        self.lbl_status = QLabel("● Đang kết nối...")
        self.lbl_status.setFont(QFont("SF Pro Text", 10))
        info_col.addWidget(self.lbl_title)
        info_col.addWidget(self.lbl_status)
        h_layout.addLayout(info_col)
        h_layout.addStretch()

        # Theme Switcher Segmented [ Auto | ☼ | ☾ ] - Fix stretching
        self.theme_bar = QFrame()
        self.theme_bar.setObjectName("themeBar")
        self.theme_bar.setFixedHeight(26)
        tb_layout = QHBoxLayout(self.theme_bar)
        tb_layout.setContentsMargins(2, 2, 2, 2)
        tb_layout.setSpacing(2)

        self.theme_buttons = {}
        for k, text in (("system", "Auto"), ("light", "☼"), ("dark", "☾")):
            b = QPushButton(text)
            b.setCursor(Qt.PointingHandCursor)
            b.setFixedHeight(22)
            if k == "system":
                b.setFixedWidth(36)
            else:
                b.setFixedWidth(24)
            b.setObjectName("subtleBtn")
            b.clicked.connect(lambda chk=False, mode=k: self.apply_theme(mode))
            tb_layout.addWidget(b)
            self.theme_buttons[k] = b

        h_layout.addWidget(self.theme_bar, 0, Qt.AlignVCenter)
        layout.addWidget(header_card)

        # ================= 2. Battery Status Card (L / R / Case) =================
        self.battery_card = QFrame()
        self.battery_card.setObjectName("card")
        b_layout = QHBoxLayout(self.battery_card)
        b_layout.setContentsMargins(12, 7, 12, 7)
        b_layout.setSpacing(8)

        # Left Earbud (L)
        self.bat_box_l = QWidget()
        l_row = QHBoxLayout(self.bat_box_l)
        l_row.setContentsMargins(0, 0, 0, 0)
        l_row.setSpacing(6)
        self.ic_bat_l = QLabel()
        self.ic_bat_l.setFixedSize(16, 16)
        lbl_l_name = QLabel("Trái:")
        lbl_l_name.setFont(QFont("SF Pro Text", 9.5))
        lbl_l_name.setObjectName("descLbl")
        self.lbl_bat_l = QLabel("--")
        self.lbl_bat_l.setFont(QFont("SF Pro Text", 10.5, QFont.Bold))
        l_row.addWidget(self.ic_bat_l)
        l_row.addWidget(lbl_l_name)
        l_row.addWidget(self.lbl_bat_l)
        l_row.addStretch()
        b_layout.addWidget(self.bat_box_l, 1)

        div1 = QFrame()
        div1.setFrameShape(QFrame.VLine)
        div1.setFixedWidth(1)
        div1.setObjectName("vDivider")
        b_layout.addWidget(div1)

        # Right Earbud (R)
        self.bat_box_r = QWidget()
        r_row = QHBoxLayout(self.bat_box_r)
        r_row.setContentsMargins(0, 0, 0, 0)
        r_row.setSpacing(6)
        self.ic_bat_r = QLabel()
        self.ic_bat_r.setFixedSize(16, 16)
        lbl_r_name = QLabel("Phải:")
        lbl_r_name.setFont(QFont("SF Pro Text", 9.5))
        lbl_r_name.setObjectName("descLbl")
        self.lbl_bat_r = QLabel("--")
        self.lbl_bat_r.setFont(QFont("SF Pro Text", 10.5, QFont.Bold))
        r_row.addWidget(self.ic_bat_r)
        r_row.addWidget(lbl_r_name)
        r_row.addWidget(self.lbl_bat_r)
        r_row.addStretch()
        b_layout.addWidget(self.bat_box_r, 1)

        div2 = QFrame()
        div2.setFrameShape(QFrame.VLine)
        div2.setFixedWidth(1)
        div2.setObjectName("vDivider")
        b_layout.addWidget(div2)

        # Case (Hộp sạc)
        self.bat_box_c = QWidget()
        c_row = QHBoxLayout(self.bat_box_c)
        c_row.setContentsMargins(0, 0, 0, 0)
        c_row.setSpacing(6)
        self.ic_bat_c = QLabel()
        self.ic_bat_c.setFixedSize(16, 16)
        lbl_c_name = QLabel("Hộp:")
        lbl_c_name.setFont(QFont("SF Pro Text", 9.5))
        lbl_c_name.setObjectName("descLbl")
        self.lbl_bat_c = QLabel("--")
        self.lbl_bat_c.setFont(QFont("SF Pro Text", 10.5, QFont.Bold))
        c_row.addWidget(self.ic_bat_c)
