            prev_color = "#1D1D1F"
            play_color = "#FFFFFF"
            subtle_icon = "#86868B"

        self.setStyleSheet(qss)

        # Theme buttons active state
        for k, btn in self.theme_buttons.items():
            btn.setObjectName("subtleBtnActive" if k == self.theme_pref else "subtleBtn")
            btn.style().unpolish(btn)
            btn.style().polish(btn)

        # Smart features icons & toggles
        for key, (sw, ic_box) in self.feature_toggles.items():
            sw.set_dark(is_dark)
            ic_name = ic_box.property("icon_name")
            ic_box.setPixmap(load_tinted_pixmap(ic_name, subtle_icon, (16, 16)))

        # Media controls icons
        self.btn_prev.setIcon(load_tinted_icon("backward", prev_color, (14, 14)))
        self.btn_next.setIcon(load_tinted_icon("forward", prev_color, (14, 14)))
        play_ic = "pause" if self.is_playing else "play"
        self.btn_play.setIcon(load_tinted_icon(play_ic, play_color, (16, 16)))

        self.btn_takeover.setIcon(load_tinted_icon("bolt", "#FFFFFF", (14, 14)))
        self.btn_release.setIcon(load_tinted_icon("device-phone-mobile", prev_color, (14, 14)))

        # Battery icons
        self.ic_bat_l.setPixmap(load_tinted_pixmap("airpod-left", subtle_icon, (16, 16)))
        self.ic_bat_r.setPixmap(load_tinted_pixmap("airpod-right", subtle_icon, (16, 16)))
        self.ic_bat_c.setPixmap(load_tinted_pixmap("airpod-case", subtle_icon, (16, 16)))

        self.update_airpods_logo()
        self.update_mode_ui()
        self.update_tune_ui()

    def update_mode_ui(self):
        is_dark = (self.effective_theme == "dark")
        for k, btn in self.mode_buttons.items():
            is_active = (k == self.current_mode)
            btn.setObjectName("segBtnActive" if is_active else "segBtn")
            btn.style().unpolish(btn)
            btn.style().polish(btn)
            ic_name = btn.property("icon_name")
            ic_col = "#FFFFFF" if is_active else ("#A1A1A6" if is_dark else "#6E6E73")
            btn.setIcon(load_tinted_icon(ic_name, ic_col, (16, 16)))
        
        self.tune_bar.setVisible(self.current_mode == "adaptive")

    def update_tune_ui(self):
        for val, btn in self.tune_buttons.items():
            btn.setObjectName("segSubBtnActive" if val == self.adaptive_strength else "segSubBtn")
            btn.style().unpolish(btn)
            btn.style().polish(btn)

    def set_noise_mode(self, mode_name):
        self.current_mode = mode_name
        self.update_mode_ui()
        send_daemon_cmd(f"mode {mode_name}")
        labels = {"anc": "Chống ồn (ANC)", "transparency": "Xuyên âm", "adaptive": "Thích ứng", "off": "Tắt kiểm soát"}
        self.lbl_msg.setText(f"Đã chuyển sang: {labels.get(mode_name, mode_name)}")

    def set_adaptive_strength(self, val):
        self.adaptive_strength = val
        self.update_tune_ui()
        send_daemon_cmd(f"adaptive_strength {val}")
        t_labels = {0: "Nhiều tiếng ồn hơn", 50: "Cân bằng (Mặc định)", 100: "Ít tiếng ồn hơn"}
        self.lbl_msg.setText(f"Mức thích ứng: {t_labels.get(val, f'{val}%')}")

    def toggle_smart_feature(self, key, checked):
        state_str = "on" if checked else "off"
        if key == "in_ear":
            send_daemon_cmd(f"ear {state_str}")
            self.lbl_msg.setText(f"Tự động tạm dừng (In-Ear): {'Bật' if checked else 'Tắt'}")
        elif key == "spatial":
            send_daemon_cmd(f"spatial {state_str}")
            self.lbl_msg.setText(f"Âm thanh không gian 3D: {'Bật' if checked else 'Tắt'}")
        elif key == "awareness":
            send_daemon_cmd(f"awareness {state_str}")
            self.lbl_msg.setText(f"Nhận biết cuộc trò chuyện: {'Bật' if checked else 'Tắt'}")
        elif key == "idle_rel":
            send_daemon_cmd(f"idle_release {state_str}")
            self.lbl_msg.setText(f"Tự động nhả khi rảnh (30s): {'Bật' if checked else 'Tắt'}")

    def on_takeover(self):
        self.lbl_msg.setText("⏳ Đang cướp từ iPhone (~2s)...")
        def worker():
            resp = send_daemon_cmd("switch")
            if resp and resp.startswith("OK"):
                self.lbl_msg.setText("✅ Cướp tai nghe thành công!")
            else:
                self.lbl_msg.setText(f"❌ {resp or 'Thất bại'}")
        threading.Thread(target=worker, daemon=True).start()

    def on_release(self):
        self.lbl_msg.setText("⏳ Đang nhả tai nghe...")
        def worker():
            resp = send_daemon_cmd("release")
            if resp and resp.startswith("OK"):
                self.lbl_msg.setText("📲 Đã nhả tai nghe cho iPhone!")
            else:
                self.lbl_msg.setText(f"❌ {resp or 'Thất bại'}")
        threading.Thread(target=worker, daemon=True).start()

    def on_media_play_pause(self):
        self.is_playing = not self.is_playing
        play_color = "#161618" if (self.effective_theme == "dark") else "#FFFFFF"
        self.btn_play.setIcon(load_tinted_icon("pause" if self.is_playing else "play", play_color, (16, 16)))
        def worker():
            self.media_ctrl.play_pause()
            time.sleep(0.3)
            _, st = self.media_ctrl.get_active_player()
            self.is_playing = (st == "Playing")
            play_col = "#161618" if (self.effective_theme == "dark") else "#FFFFFF"
            self.btn_play.setIcon(load_tinted_icon("pause" if self.is_playing else "play", play_col, (16, 16)))
        threading.Thread(target=worker, daemon=True).start()

    def on_media_next(self):
        threading.Thread(target=self.media_ctrl.next_track, daemon=True).start()

    def on_media_prev(self):
        threading.Thread(target=self.media_ctrl.previous_track, daemon=True).start()

    def refresh_state(self):
        # 1. Media Player Info (tối ưu hóa 1 lệnh duy nhất)
        player, status, meta = self.media_ctrl.get_media_info()
        self.is_playing = (status == "Playing")
        play_color = "#161618" if (self.effective_theme == "dark") else "#FFFFFF"
        self.btn_play.setIcon(load_tinted_icon("pause" if self.is_playing else "play", play_color, (16, 16)))
        title = meta.get("title", "")
        artist = meta.get("artist", "")
        art_url = meta.get("art_url", "")
        app_name = meta.get("app_name", "Media")

        # Smooth elided text
        fm = QFontMetrics(self.lbl_track_title.font())
        elided_title = fm.elidedText(title, Qt.ElideRight, 205)
        self.lbl_track_title.setText(elided_title)
        
        fm_art = QFontMetrics(self.lbl_track_artist.font())
        sub_text = f"{artist} · {app_name}" if artist else app_name
        self.lbl_track_artist.setText(fm_art.elidedText(sub_text, Qt.ElideRight, 205))

        # Thumbnail art (chỉ render lại khi đổi bài hát để tiết kiệm RAM/CPU)
        if art_url != getattr(self, "current_art_url", None):
            self.current_art_url = art_url
            if art_url and os.path.exists(art_url):
                try:
                    dpr = get_dpr()
                    phys_size = int(38 * dpr)
                    src = QPixmap(art_url).scaled(phys_size, phys_size, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation)
                    dest = QPixmap(phys_size, phys_size)
                    dest.setDevicePixelRatio(dpr)
                    dest.fill(Qt.transparent)
                    p = QPainter(dest)
                    p.setRenderHint(QPainter.Antialiasing)
                    p.setRenderHint(QPainter.SmoothPixmapTransform)
                    path = QPainterPath()
                    path.addRoundedRect(0, 0, 38, 38, 8, 8)
                    p.setClipPath(path)
                    p.drawPixmap(0, 0, 38, 38, src)
                    p.end()
                    self.lbl_media_art.setPixmap(dest)
                except Exception:
                    self.set_default_art()
            else:
                self.set_default_art()

        # 2. Daemon Status & Battery
        ipc_resp = send_daemon_cmd("status")
        if ipc_resp and ipc_resp.startswith("OK"):
            props = dict(item.split("=", 1) for item in ipc_resp[3:].split() if "=" in item)
            connected = (props.get("status") == "connected")
            bat_l = props.get("bat_l", "-1")
            bat_r = props.get("bat_r", "-1")
            bat_c = props.get("bat_c", "-1")
            bat_c_conn = props.get("bat_c_conn", "0")
            bat_main = props.get("bat_main", "-1")
            chg_l = props.get("chg_l", "0")
            chg_r = props.get("chg_r", "0")
            chg_c = props.get("chg_c", "0")
            mode = props.get("mode", self.current_mode)
            try:
                adapt_str = int(props.get("adapt_str", 50))
            except ValueError:
                adapt_str = 50
            
            if mode != self.current_mode:
                self.current_mode = mode
                self.update_mode_ui()
            if adapt_str != self.adaptive_strength:
                self.adaptive_strength = adapt_str
                self.update_tune_ui()

            def get_bat_color(val):
                try:
                    v = int(val)
                    if v > 20: return "#34C759"
                    if v > 10: return "#FF9500"
                    return "#FF3B30"
                except Exception:
                    return "#86868B"

            if connected:
                self.lbl_status.setText("● Đã kết nối (AAC • 48 kHz)")
                self.lbl_status.setStyleSheet("color: #34C759; font-weight: 500;")
                self.btn_takeover.setEnabled(True)
                self.btn_release.setEnabled(True)

                # Left earbud battery
                if bat_l != "-1":
                    chg_mark = " ⚡" if chg_l == "1" else ""
                    self.lbl_bat_l.setText(f"{bat_l}%{chg_mark}")
                    self.lbl_bat_l.setStyleSheet(f"color: {get_bat_color(bat_l)};")
                elif bat_main != "-1":
                    self.lbl_bat_l.setText(f"{bat_main}%")
                    self.lbl_bat_l.setStyleSheet(f"color: {get_bat_color(bat_main)};")
                else:
                    self.lbl_bat_l.setText("--")
                    self.lbl_bat_l.setStyleSheet("color: #86868B;")

                # Right earbud battery
                if bat_r != "-1":
                    chg_mark = " ⚡" if chg_r == "1" else ""
                    self.lbl_bat_r.setText(f"{bat_r}%{chg_mark}")
                    self.lbl_bat_r.setStyleSheet(f"color: {get_bat_color(bat_r)};")
                elif bat_main != "-1":
                    self.lbl_bat_r.setText(f"{bat_main}%")
                    self.lbl_bat_r.setStyleSheet(f"color: {get_bat_color(bat_main)};")
                else:
                    self.lbl_bat_r.setText("--")
                    self.lbl_bat_r.setStyleSheet("color: #86868B;")

                # Case battery
                if bat_c != "-1":
                    chg_mark = " ⚡" if chg_c == "1" else ""
                    if bat_c_conn == "1":
                        self.lbl_bat_c.setText(f"{bat_c}%{chg_mark}")
                        self.lbl_bat_c.setStyleSheet(f"color: {get_bat_color(bat_c)};")
                        self.bat_box_c.setToolTip(f"Hộp sạc: {bat_c}% (Đang mở nắp / Đang kết nối)")
                    else:
                        self.lbl_bat_c.setText(f"~{bat_c}%{chg_mark}")
                        self.lbl_bat_c.setStyleSheet(f"color: {get_bat_color(bat_c)};")
                        self.bat_box_c.setToolTip(f"Hộp sạc: ~{bat_c}% (Nắp hộp đang đóng. Mức pin lưu từ lần mở nắp gần nhất)")
                else:
                    self.lbl_bat_c.setText("--")
                    self.lbl_bat_c.setStyleSheet("color: #86868B;")
                    self.bat_box_c.setToolTip("Mở nắp hộp để cập nhật mức pin của hộp sạc")
            else:
                self.lbl_status.setText("○ Đang trên iPhone hoặc trong hộp")
                self.lbl_status.setStyleSheet("color: #86868B;")
                self.btn_takeover.setEnabled(True)
                self.btn_release.setEnabled(False)
                self.lbl_bat_l.setText("--")
                self.lbl_bat_l.setStyleSheet("color: #86868B;")
                self.lbl_bat_r.setText("--")
                self.lbl_bat_r.setStyleSheet("color: #86868B;")
                self.lbl_bat_c.setText("--")
                self.lbl_bat_c.setStyleSheet("color: #86868B;")

            # Sync toggles
            for key, (sw, _) in self.feature_toggles.items():
                sw.blockSignals(True)
                if key == "in_ear":
                    sw.setChecked(props.get("in_ear") == "1")
                elif key == "spatial":
                    sw.setChecked(props.get("spatial") == "1")
                elif key == "awareness":
                    sw.setChecked(props.get("awareness") == "1")
                elif key == "idle_rel":
                    sw.setChecked(props.get("idle_rel") == "1")
                sw.blockSignals(False)

    def set_default_art(self):
        dpr = get_dpr()
        phys_size = int(38 * dpr)
        pm = load_tinted_pixmap("musical-note", "#0071E3", (22, 22))
        dest = QPixmap(phys_size, phys_size)
        dest.setDevicePixelRatio(dpr)
        dest.fill(Qt.transparent)
        p = QPainter(dest)
        p.setRenderHint(QPainter.Antialiasing)
        p.setBrush(QColor(0, 113, 227, 28))
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(0, 0, 38, 38, 8, 8)
        if not pm.isNull():
            p.drawPixmap(8, 8, 22, 22, pm)
        p.end()
        self.lbl_media_art.setPixmap(dest)

if __name__ == "__main__":
    if try_raise_existing_instance():
        sys.exit(0)

    QApplication.setHighDpiScaleFactorRoundingPolicy(Qt.HighDpiScaleFactorRoundingPolicy.PassThrough)
    app = QApplication(sys.argv)
    app.setApplicationName("airpods")
    app.setDesktopFileName("airpods")
    app.setWindowIcon(QIcon("/opt/podhop/airpods.png"))
    app.setQuitOnLastWindowClosed(False)
    win = AirPodsManager()
    win.show()
    sys.exit(app.exec())
