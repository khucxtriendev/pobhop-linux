[Unit]
Description=PodHop - AirPods Audio Auto-Switching Daemon
After=pipewire.service wireplumber.service bluetooth.target
Wants=pipewire.service

[Service]
Type=simple
Environment=PYTHONOPTIMIZE=2
Environment=MALLOC_TRIM_THRESHOLD_=65536
MemoryHigh=20M
MemoryMax=35M
ExecStart=/usr/local/bin/podhop-daemon
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
